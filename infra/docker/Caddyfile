# SIGAP web server (NF-05). With a real domain in SIGAP_DOMAIN, Caddy gets and
# renews the HTTPS certificate by itself (ports 80 and 443 must reach the server).
# "localhost" gives a local certificate, for trying the images on a laptop.

{$SIGAP_DOMAIN:localhost} {
	encode zstd gzip

	# Laravel: API, API docs (Scramble), health check
	@backend path /api/* /docs/api* /up
	handle @backend {
		root * /app/public
		php_fastcgi app:9000
	}

	# The PWA: static files, every other path falls back to index.html (client routing)
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}

	# A new service worker must be seen at once, so "Muat ulang" appears (PW-09)
	@nocache path /sw.js /workbox-*.js /index.html /manifest.webmanifest
	header @nocache Cache-Control "no-cache"
	# Built files carry a hash in their name
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
