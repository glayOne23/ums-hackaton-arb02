# Copy to infra/docker/.env and fill in. Never commit the filled-in file.

# Domain pointing to this server. Caddy gets the HTTPS certificate for it.
# "localhost" = a local certificate, for trying the images on a laptop.
SIGAP_DOMAIN=sigap.contoh.id

APP_NAME=SIGAP
APP_ENV=production
APP_DEBUG=false
# docker compose -f infra/docker/compose.yaml run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://sigap.contoh.id
APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=sigap
DB_USERNAME=sigap
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Push notifications (README "Menjalankan di server" step 1). Generate once:
#   docker compose -f infra/docker/compose.yaml run --rm app php artisan webpush:vapid --show
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@contoh.id

# Daily backup (NF-06). "backups" = storage/app/backups on this server; better an S3 disk off the server
BACKUP_DISK=backups
BACKUP_NOTIFY_EMAIL=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@contoh.id
MAIL_FROM_NAME=SIGAP
